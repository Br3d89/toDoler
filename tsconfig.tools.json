/* Typechecking for the repo code that is not the Angular app: the check-gate
   guards in tools/ and the agent harness in .sandcastle/, both of which run
   in plain Node rather than the browser. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    /* A house style rule for app code, not a soundness check. The .sandcastle
       harness is generated by @ai-hero/sandcastle and reads process.env with
       dot access; rewriting it would be churn on every regeneration. */
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "vitest.config.mts",
    "tools/**/*.ts",
    ".sandcastle/**/*.ts",
    ".sandcastle/**/*.mts"
  ],
  "exclude": [
    /* Markdown that ships with a .ts extension, not TypeScript. */
    ".sandcastle/CODING_STANDARDS.ts"
  ]
}
