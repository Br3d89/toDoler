{
  "name": "to-doler",
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:tools": "vitest run",
    "lint": "ng lint",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run test && pnpm run test:tools"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0",
    "zod": "^4.4.3"
  }
}
